      <column caption='Area Code' datatype='string' name='[AreaCode]' role='dimension' semantic-role='[AreaCode].[Name]' type='nominal' />
      <column caption='Number of Orders' datatype='integer' name='[Calculation_1199083456277729280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([OrderNumber])' />
      </column>
      <column caption='Unit Profit' datatype='real' name='[Calculation_1199083456279875585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([UnitPrice]-[UnitCost])*[OrderQuantity])' />
      </column>
      <column caption='Total Profit by State' datatype='real' default-format='C1033%' name='[Calculation_1199083456289001474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] :   SUM(([UnitPrice]-[UnitCost])*[OrderQuantity])}' />
      </column>
      <column caption='Category Fixed Average Unit Profit' datatype='real' name='[Calculation_1199083456930746375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Category] : avg(([UnitPrice]-[UnitCost])*[OrderQuantity])}' />
      </column>
      <column caption='Category Fixed Average Unit Cost ' datatype='real' name='[Calculation_1199083456930988040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Category]: AVG([UnitCost])}' />
      </column>
      <column caption='Total Average Unit Profit' datatype='real' default-format='C1033%' name='[Calculation_1199083456939544587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(([UnitPrice]-[UnitCost])*[OrderQuantity])}' />
      </column>
      <column caption='Total Average Unit Cost' datatype='real' default-format='C1033%' name='[Calculation_1199083456941207564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([UnitCost])}' />
      </column>
      <column caption='Total Cost ' datatype='real' name='[Calculation_975029375894609921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([UnitCost]*[OrderQuantity])' />
      </column>
      <column caption='Select Your Metric' datatype='real' name='[Calculation_975029376587993090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Profit&apos; THEN sum(([UnitPrice]-[UnitCost])*[OrderQuantity])&#13;&#10;WHEN &apos;Sales&apos; THEN COUNT([OrderNumber])&#13;&#10;ELSE SUM([UnitCost]*[OrderQuantity])&#13;&#10;END' />
      </column>
      <column caption='Cost Indicator' datatype='string' name='[Calculation_975029376642990087]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (([Calculation_975029375894609921]) - LOOKUP(ZN([Calculation_975029375894609921]), -1))&lt;0 OR &#13;&#10;ZN([Calculation_1199083456279875585]) - LOOKUP(ZN([Calculation_1199083456279875585]), -1) &lt;0&#13;&#10;THEN &quot;Red&quot; &#13;&#10;ELSE &quot;Green&quot; &#13;&#10;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
